# Copy to .env (scripts/lab-up.sh does this). .env is git-ignored.
# The ESL password is NOT stored here: it lives in secrets/esl_password (git-ignored),
# generated by scripts/lab-up.sh and mounted into the container as a Docker secret.

# Private Docker network for the lab; also the only non-loopback range the ESL ACL allows.
LAB_SUBNET=172.29.77.0/24

# Host address on which SIP/RTP are published. Keep 127.0.0.1 unless you understand the exposure.
HOST_BIND_ADDR=127.0.0.1
