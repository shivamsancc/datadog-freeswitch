<configuration name="acl.conf" description="Network Lists">
  <network-lists>
    <!-- ESL clients: loopback and the private lab network only -->
    <list name="esl_lab" default="deny">
      <node type="allow" cidr="127.0.0.1/32"/>
      <node type="allow" cidr="$${lab_subnet}"/>
    </list>
  </network-lists>
</configuration>
