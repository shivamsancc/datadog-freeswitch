+@pytest.mark.parametrize(
+    'advertised',
+    [
+        'all',
+        'ALL',
+        None,  # header absent: the server did not say what the account may do
+        '',
+        'uptime',  # cannot do the channel query; refuse early
+        'show',
+        'uptime,show,status',
+        'uptime,show,system',
+        'uptime, show',  # server would split on the space and see "uptime,"
+        'uptime,,show',
+        'uptime,show,',
+        ',uptime,show',
+        'Uptime,show',
+    ],
+)
